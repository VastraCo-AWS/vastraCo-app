# JWT — use a long random string (min 32 chars), never commit the real value
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars

# User Service DB
USER_DB_HOST=users-db
USER_DB_PORT=5432
USER_DB_NAME=users_db
USER_DB_USER=vastraco_user
USER_DB_PASSWORD=replace_with_strong_password

# Product Service DB
PRODUCT_DB_HOST=products-db
PRODUCT_DB_PORT=5432
PRODUCT_DB_NAME=products_db
PRODUCT_DB_USER=vastraco_product
PRODUCT_DB_PASSWORD=replace_with_strong_password

# Order Service DB
ORDER_DB_HOST=orders-db
ORDER_DB_PORT=5432
ORDER_DB_NAME=orders_db
ORDER_DB_USER=vastraco_order
ORDER_DB_PASSWORD=replace_with_strong_password

# Inter-service URLs (used inside Docker network)
PRODUCT_SERVICE_URL=http://product-service:3002
USER_SERVICE_URL=http://user-service:3001

# AI Service — Groq (https://console.groq.com)
# Steps to activate:
#   1. Create an account at console.groq.com
#   2. Generate an API key under API Keys
#   3. Fill in the values below (never commit the real .env file)
# On EKS: GROQ_API_KEY is injected from vastraco/app-secrets via Secrets Manager CSI Driver
GROQ_API_KEY=your_groq_api_key_here
# Model options (all support tool use on Groq):
#   llama-3.3-70b-versatile      — production recommended (131k ctx, Meta)
#   llama-3.1-8b-instant         — low latency, smaller context tasks
#   meta-llama/llama-4-scout-17b-16e-instruct — newest Meta model
GROQ_MODEL=llama-3.3-70b-versatile
